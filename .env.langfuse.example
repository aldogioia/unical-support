# Copy outside the repository, e.g. /home/operatore/secrets/langfuse.env.
# Generate a DIFFERENT value with openssl rand -hex 32 for each blank below.
LF_POSTGRES_PASSWORD=
LF_CLICKHOUSE_PASSWORD=
LF_REDIS_PASSWORD=
LF_S3_PASSWORD=
LF_AUTH_SECRET=
LF_SALT=
LF_ENCRYPTION_KEY=
LF_IMAGE_TAG=4
LF_PORT=3000
LF_PUBLIC_URL=http://localhost:3000

# Application SDK (project keys are created in Langfuse AFTER first startup).
# Development .env: LANGFUSE_ENABLED=true
# LANGFUSE_BASE_URL=http://host.docker.internal:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_ENVIRONMENT=development
