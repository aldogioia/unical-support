# Add these values to .env. Keep MAIL_PASSWORD out of version control.
MAIL_PROVIDER=smtp
MAIL_USERNAME=support@example.org
MAIL_FROM=
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURITY=ssl
MAIL_IMAP_FOLDER=INBOX
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURITY=ssl
MAIL_TIMEOUT_SECONDS=30
MAIL_FETCH_LIMIT=50

# Development only: .env is read by the application in the mounted workspace.
# MAIL_PASSWORD=your-app-password
# Production: store the password in the file mounted by docker-compose.smtp.yml.
MAIL_PASSWORD_SECRET_FILE=/home/operatore/secrets/mail_password
